{
  "name": "zds",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "docs:dev": "pnpm --filter @zds/tokens build && pnpm --filter @zds/react build && pnpm --filter @zds/docs dev",
    "docs:build": "turbo run build --filter=@zds/docs",
    "storybook": "pnpm --filter @zds/tokens build && storybook dev -p 6006",
    "storybook:build": "pnpm --filter @zds/tokens build && storybook build --output-dir dist/storybook",
    "generate:icons": "pnpm --filter @zds/react generate:icons",
    "validate:docs-system": "pnpm docs:build && node testing/docs/validate-docs-build.mjs && node testing/docs/validate-preview-links.mjs && node testing/docs/validate-docs-system.mjs",
    "validate:tokens": "node testing/tokens/validate-tokens.mjs",
    "validate:button-spec": "node testing/spec/validate-button-spec.mjs",
    "test:button-react": "pnpm --filter @zds/tokens build && node --import tsx --test packages/react/src/components/button/Button.test.tsx",
    "validate:breadcrumb-spec": "node testing/spec/validate-breadcrumb-spec.mjs",
    "test:breadcrumb-react": "pnpm --filter @zds/tokens build && node --import tsx --test packages/react/src/components/breadcrumb/Breadcrumb.test.tsx",
    "validate:button-swiftui": "pnpm --filter @zds/swiftui build",
    "validate:button-kotlin": "pnpm --filter @zds/kotlin build",
    "validate:button-windows": "pnpm --filter @zds/windows build",
    "validate:button-native": "pnpm validate:button-swiftui && pnpm validate:button-kotlin && pnpm validate:button-windows",
    "validate:button": "pnpm validate:tokens && pnpm validate:button-spec && pnpm test:button-react && pnpm validate:docs-system",
    "validate:breadcrumb": "pnpm validate:tokens && pnpm validate:breadcrumb-spec && pnpm test:breadcrumb-react && pnpm validate:docs-system"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.3.0",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "next": "^15.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "turbo": "^2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
