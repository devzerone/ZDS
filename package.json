{
  "name": "zds",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "docs:dev": "pnpm --filter @zds/docs dev",
    "docs:build": "pnpm --filter @zds/docs build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir dist/storybook",
    "validate:docs-system": "pnpm docs:build && node testing/docs/validate-docs-build.mjs && pnpm storybook:build && node testing/docs/validate-storybook-build.mjs && node testing/docs/validate-preview-links.mjs && node testing/docs/validate-docs-system.mjs",
    "validate:tokens": "node testing/tokens/validate-tokens.mjs",
    "validate:button-spec": "node testing/spec/validate-button-spec.mjs",
    "test:button-react": "node --import tsx --test packages/react/components/button/Button.test.tsx",
    "validate:button": "pnpm validate:tokens && pnpm validate:button-spec && pnpm test:button-react"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.3.0",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "next": "^15.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.3",
    "tsx": "^4.20.6",
    "turbo": "^2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
