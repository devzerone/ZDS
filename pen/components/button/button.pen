{
  "version": "2.9",
  "children": [
    {
      "id": "button-baseline-board",
      "type": "frame",
      "name": "Button Visual Baseline",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 920,
      "fill": "#F8F9FB",
      "layout": "vertical",
      "gap": 32,
      "padding": 32,
      "children": [
        {
          "id": "header",
          "type": "frame",
          "layout": "vertical",
          "width": "fill_container",
          "gap": 8,
