            {
              "id": "title",
              "type": "text",
              "content": "Button Visual Baseline",
              "fill": "#171B24",
              "fontFamily": "Inter",
              "fontSize": 28,
              "fontWeight": "700"
            },
            {
              "id": "subtitle",
              "type": "text",
              "content": "Primary, secondary, tertiary, destructive variants with size and state references.",
              "fill": "#515967",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "400"
            }
          ]
        },
        {
          "id": "matrix",
          "type": "frame",
