{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "docs:build": {
      "outputs": ["apps/docs/dist/**"]
    },
    "storybook:build": {
      "outputs": ["dist/storybook/**"]
    },
    "validate:docs-system": {
      "dependsOn": ["docs:build", "storybook:build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
