<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ZDS.Demo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
  </ItemGroup>

  <!-- Link breadcrumb component + tokens from parent package -->
  <ItemGroup>
    <Page Include="..\components\Breadcrumb.xaml" Link="Components\Breadcrumb.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="..\components\Breadcrumb.xaml.cs" Link="Components\Breadcrumb.xaml.cs" />
    <Page Include="..\.generated\BreadcrumbTokens.xaml" Link="Generated\BreadcrumbTokens.xaml" />
    <Page Include="..\.generated\FoundationTokens.xaml" Link="Generated\FoundationTokens.xaml" />
  </ItemGroup>
</Project>
