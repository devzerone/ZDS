<UserControl
    x:Class="ZDS.Components.Breadcrumb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.LandmarkType="Navigation">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Generated/FoundationTokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Generated/BreadcrumbTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
      Review note: WinUI 3 preserves the shared item roles (ancestor, current, collapsed-summary),
      collapse logic, and separator semantics aligned with the React reference implementation.
    -->
    <Grid>
        <StackPanel x:Name="ItemContainer"
                     Orientation="Horizontal"
                     VerticalAlignment="Center" />
    </Grid>
</UserControl>
