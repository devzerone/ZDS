{
  "name": "@zds/foundation",
  "version": "0.0.0",
  "private": false,
  "files": ["assets", "icons"],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git@github-work:devzerone/ZDS.git"
  },
  "exports": {
    "./assets/*": "./assets/*",
    "./icons/*": "./icons/*"
  },
  "scripts": {
    "build": "node -e \"console.log('No build step required for @zds/foundation assets.')\""
  },
  "zdsArtifact": {
    "type": "asset-package",
    "contents": ["brand-assets", "foundation-shared-assets"]
  }
}
