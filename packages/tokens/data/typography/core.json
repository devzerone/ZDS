{
  "$schema": "../schemas/typography.schema.json",
  "meta": {
    "name": "zds-typography-core"
  },
  "tokens": {
    "font.title.lg": {
      "fontFamily": "'Pretendard Variable', 'Pretendard', sans-serif",
      "fontSize": 40,
      "lineHeight": 52,
      "fontWeight": 700,
      "usage": "Hero and major section titles"
    },
    "font.title.md": {
      "fontFamily": "'Pretendard Variable', 'Pretendard', sans-serif",
      "fontSize": 32,
      "lineHeight": 42,
      "fontWeight": 700,
      "usage": "Section titles"
    },
    "font.title.sm": {
      "fontFamily": "'Pretendard Variable', 'Pretendard', sans-serif",
      "fontSize": 24,
      "lineHeight": 32,
      "fontWeight": 600,
      "usage": "Subsection titles"
    },
    "font.body.lg": {
      "fontFamily": "'Pretendard Variable', 'Pretendard', sans-serif",
      "fontSize": 18,
      "lineHeight": 28,
